# Ocular OCR - Secrets and Credentials Template
# Copy this file to .env and configure with your actual credentials
#
# WARNING: Never commit .env files to version control!
# Add .env to your .gitignore file
#
# IMPORTANT: Non-secret configuration is now in ocular.json
# This file should only contain API keys, tokens, passwords, and other secrets

# =============================================================================
# OCR PROVIDER API KEYS
# =============================================================================

# Mistral AI (Recommended primary provider)
# Get API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Cloud Vision API (optional)
# Setup guide: https://cloud.google.com/vision/docs/setup
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
# GOOGLE_PROJECT_ID=your-gcp-project-id

# AWS Textract (optional)
# Setup guide: https://docs.aws.amazon.com/textract/latest/dg/setup.html
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# Azure Document Intelligence (optional)
# Setup guide: https://docs.microsoft.com/en-us/azure/applied-ai-services/form-recognizer/
# AZURE_DOC_INTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOC_INTEL_API_KEY=your_azure_api_key

# =============================================================================
# CLOUD GPU PROVIDER CREDENTIALS
# =============================================================================

# RunPod API Credentials
# Setup guide: https://www.runpod.io/serverless
# Get these from: https://www.runpod.io/console/user/settings
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
RUNPOD_API_KEY=your_runpod_api_key_here

# RunPod S3-Compatible Storage Credentials
# These are used for model storage and deployment
RUNPOD_AWS_ACCESS_KEY_ID=your_runpod_s3_access_key_here
RUNPOD_AWS_SECRET_ACCESS_KEY=your_runpod_s3_secret_key_here
RUNPOD_BUCKET_ACCESS_KEY_ID=your_runpod_s3_access_key_here
RUNPOD_BUCKET_SECRET_ACCESS_KEY=your_runpod_s3_secret_key_here
RUNPOD_BUCKET_NAME=your-runpod-bucket-name
RUNPOD_BUCKET_ENDPOINT_URL=https://storage.runpod.io

# Vast.ai Credentials (optional)
# Uncomment if using Vast.ai for GPU deployments
# Get these from: https://cloud.vast.ai/
# VASTAI_INSTANCE_ID=your-vastai-instance-id
# VASTAI_API_KEY=your-vastai-api-key

# DeepInfra Credentials (optional)
# Uncomment if using DeepInfra for managed inference
# Get token from: https://deepinfra.com/dash/api_keys
# DEEPINFRA_TOKEN=your-deepinfra-api-token

# HuggingFace Token (for model downloads)
# Get token from: https://huggingface.co/settings/tokens
# This is used to download models from HuggingFace Hub
HF_TOKEN=your_huggingface_token_here

# DeepL API Key (for automated translations - optional)
# Get API key from: https://www.deepl.com/pro-api
# Only needed if you want to use automated translation with DeepL
# DEEPL_API_KEY=your_deepl_api_key_here

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================

# Clerk Authentication (optional)
# Get these from: https://dashboard.clerk.com/
# CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# JWT Settings (if using custom auth)
# Generate a secure random key for JWT signing
# JWT_SECRET_KEY=your_super_secure_jwt_secret_key_here

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe Payment Processing (optional)
# Get these from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# DATABASE & CACHING
# =============================================================================

# Database connection (optional - for advanced usage)
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost/ocular_db

# Redis caching (optional - for improved performance)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Logfire Integration (optional)
# Get token from: https://logfire.pydantic.dev/
# LOGFIRE_TOKEN=your_logfire_token_here

# Sentry Error Tracking (optional)
# Get DSN from: https://sentry.io/
# SENTRY_DSN=your_sentry_dsn_here

# New Relic APM (optional)
# Get license key from: https://one.newrelic.com/
# NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# =============================================================================
# SECURITY KEYS
# =============================================================================

# API Security (optional)
# Generate secure random keys for API authentication and encryption
# API_SECRET_KEY=your_api_secret_key_here
# ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# CUSTOM PROVIDER ENDPOINTS
# =============================================================================

# Custom OCR Endpoint (if using self-hosted solution)
# CUSTOM_OCR_ENDPOINT=https://your-custom-ocr-service.com/api/v1
# CUSTOM_OCR_API_KEY=your_custom_api_key

# =============================================================================
# FILE STORAGE CREDENTIALS
# =============================================================================

# AWS S3 (if using for file storage)
# S3_BUCKET=your-s3-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_s3_access_key_id
# S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# Multiple AWS S3 Buckets (comma-separated, for model storage)
# These will appear in the models upload dropdown
# AWS_S3_BUCKETS=bucket1,bucket2,bucket3

# Custom S3-Compatible Storage Buckets (comma-separated)
# For services like MinIO, DigitalOcean Spaces, etc.
# CUSTOM_S3_BUCKETS=custom-bucket-1,custom-bucket-2
# CUSTOM_S3_ENDPOINT_URL=https://your-custom-s3-endpoint.com
# CUSTOM_S3_ACCESS_KEY_ID=your_custom_s3_access_key
# CUSTOM_S3_SECRET_ACCESS_KEY=your_custom_s3_secret_key

# Google Cloud Storage (if using for file storage)
# GCS_BUCKET=your-gcs-bucket-name
# GCS_CREDENTIALS_JSON=/path/to/gcs-credentials.json

# Azure Blob Storage (if using for file storage)
# AZURE_STORAGE_ACCOUNT=your-azure-storage-account
# AZURE_STORAGE_KEY=your-azure-storage-key

# =============================================================================
# CONFIGURATION NOTES
# =============================================================================

# 1. REQUIRED SECRETS:
#    - At least one OCR provider API key (MISTRAL_API_KEY recommended)
#    - Cloud GPU provider credentials if deploying custom models
#
# 2. CONFIGURATION FILES:
#    - .env (this file) - Secrets and credentials only
#    - ocular.json - Non-sensitive configuration (app settings, model definitions, provider configs)
#
# 3. ALL NON-SECRET CONFIGURATION HAS MOVED TO ocular.json:
#    - Application settings (title, version, debug mode, etc.)
#    - File handling limits (max file size, supported formats, etc.)
#    - AI model definitions (model metadata, Docker images, VRAM requirements, etc.)
#    - Cloud provider configurations (available GPUs, features, etc.)
#    - Logging settings (log level, format, file logging, etc.)
#    - Security settings (CORS, rate limits, HTTPS enforcement, etc.)
#    - Caching settings (TTL, enable/disable, etc.)
#
# 4. SECURITY BEST PRACTICES:
#    - Never commit this file to version control (add .env to .gitignore)
#    - Use environment-specific .env files (.env.development, .env.production)
#    - Rotate API keys regularly (at least every 90 days)
#    - Use least-privilege access for cloud services
#    - Store production secrets in secure vaults:
#      * AWS: AWS Secrets Manager or AWS Systems Manager Parameter Store
#      * GCP: Google Secret Manager
#      * Azure: Azure Key Vault
#      * Generic: HashiCorp Vault
#    - Never log or display secret values in application output
#
# 5. ENVIRONMENT-SPECIFIC CONFIGURATION:
#    - Development: Use test API keys and local services when possible
#    - Staging: Use separate staging credentials, never production secrets
#    - Production: Use production credentials stored in secure vaults
#
# 6. GETTING STARTED:
#    a. Copy this file to .env:
#       cp .env.example .env
#    b. Fill in at least MISTRAL_API_KEY for basic OCR functionality
#    c. Add cloud GPU credentials if deploying custom models
#    d. Review and customize ocular.json for non-secret settings
#    e. Run the application:
#       source .venv/bin/activate
#       uvicorn ocular.app:app --reload
#
# 7. TROUBLESHOOTING:
#    - If OCR providers are unavailable, check API keys in this file
#    - If deployments fail, verify cloud provider credentials
#    - Run /health endpoint to check provider status
#    - Check logs for detailed error messages
#    - See CLAUDE.md for comprehensive setup guide
